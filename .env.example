# MATVERSE OpenAI provider runtime
# Never commit a real API key. Inject it through the deployment/platform secret
# manager into OPENAI_API_KEY. The authenticated /providers/openai/* route does
# not read the value directly; EnvironmentSecretVault exposes it only through a
# bounded Secret Plane lease after the provider-exposure gate passes.
OPENAI_API_KEY=

# Version the injected credential explicitly when rotating it. This public
# version number is safe to persist; the credential value and locator are not.
OPENAI_SECRET_VERSION=1

# Explicit model binding is required. This prevents silent cost/capability drift.
OPENAI_MODEL=gpt-6-astra

# Optional runtime limits.
OPENAI_TIMEOUT_SECONDS=120
# OPENAI_MAX_OUTPUT_TOKENS=4096

# Existing MatVerse authenticated-principal registry remains required for
# /providers/openai/* endpoints.
# MATVERSE_PRINCIPALS_JSON={"operator":{"secret":"...","capabilities":["provider:openai:read","provider:openai:invoke"]}}

# ---------------------------------------------------------------------------
# Zenodo OAuth -> ChatGPT MCP Bridge
# ---------------------------------------------------------------------------
# Create a CONFIDENTIAL OAuth application in Zenodo. Never paste the client
# secret into a chat or commit it to Git.
ZENODO_CLIENT_ID=
ZENODO_CLIENT_SECRET=

# Local development callback. Must exactly match the URI registered in Zenodo.
ZENODO_REDIRECT_URI=http://localhost:8788/zenodo/oauth/callback
ZENODO_BASE_URL=https://zenodo.org

# Least privilege default: can create/update drafts but cannot publish.
# Add deposit:actions only when irreversible publish/edit/discard actions are
# intentionally enabled.
ZENODO_SCOPES=deposit:write

# Runtime-only secrets. Generate independently:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ZENODO_OAUTH_STATE_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZENODO_TOKEN_ENCRYPTION_KEY=

# Encrypted local token state. Directory is gitignored.
ZENODO_TOKEN_DB=.data/zenodo-oauth.sqlite3

# Local OAuth callback + Streamable HTTP MCP endpoints.
ZENODO_OAUTH_HOST=127.0.0.1
ZENODO_OAUTH_PORT=8788
ZENODO_MCP_HOST=127.0.0.1
ZENODO_MCP_PORT=8800
# ZENODO_OAUTH_PUBLIC_BASE=http://localhost:8788

# Fail-closed remote exposure. Do not set this until MCP ingress authentication
# is configured for a deployed HTTPS endpoint.
# ZENODO_MCP_REMOTE_AUTH_READY=1
