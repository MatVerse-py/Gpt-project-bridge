# MATVERSE OpenAI provider runtime
# Never commit a real API key. Inject it through the deployment/platform secret
# manager into OPENAI_API_KEY. The authenticated /providers/openai/* route does
# not read the value directly; EnvironmentSecretVault exposes it only through a
# bounded Secret Plane lease after the provider-exposure gate passes.
OPENAI_API_KEY=

# Version the injected credential explicitly when rotating it. This public
# version number is safe to persist; the credential value and locator are not.
OPENAI_SECRET_VERSION=1

# Explicit model binding is required. This prevents silent cost/capability drift.
OPENAI_MODEL=gpt-6-astra

# Optional runtime limits.
OPENAI_TIMEOUT_SECONDS=120
# OPENAI_MAX_OUTPUT_TOKENS=4096

# Existing MatVerse authenticated-principal registry remains required for
# /providers/openai/* endpoints.
# MATVERSE_PRINCIPALS_JSON={"operator":{"secret":"...","capabilities":["provider:openai:read","provider:openai:invoke"]}}

# Generate with: python3 scripts/generate_env.py
GPB_API_TOKEN=replace-with-a-long-random-token
GPB_PUBLIC_API_URL=http://localhost:8787
GPB_DOMAIN=bridge.example.com

# Development defaults to static auth. Production compose overrides to hybrid.
PROJECTVAULT_AUTH_MODE=static
PROJECTVAULT_OIDC_ISSUER=https://idp.example.com/
PROJECTVAULT_OIDC_AUDIENCE=https://bridge.example.com
PROJECTVAULT_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
PROJECTVAULT_REQUIRED_SCOPE=projects.read

# Owner Access Fabric. When a registry is configured, federated read tools are
# exposed over MCP. Provider credentials named inside the registry remain in
# environment variables and are never returned by the Bridge.
# PROJECTVAULT_PARTITION_REGISTRY=/app/config/partitions.json
PROJECTVAULT_PARTITION_TIMEOUT_SECONDS=10
PROJECTVAULT_MAX_FEDERATED_PARTITIONS=32

# Optional credentials for native read-only partitions. Tokens are provisioned
# outside the Bridge and must carry the provider's own read scopes. The Bridge
# does not implement credential escalation or provider permission bypass.
# OWNER_GITHUB_TOKEN=
# OWNER_GOOGLE_ACCESS_TOKEN=
# OWNER_NOTION_TOKEN=
# OWNER_CHATGPT_HOST_MCP_TOKEN=

# Large archive intake. Values are bytes; keep the staging directory on a volume
# with at least twice the archive size plus PROJECTVAULT_MIN_FREE_BYTES available.
PROJECTVAULT_STAGING_DIR=/app/data/staging
PROJECTVAULT_MAX_UPLOAD_BYTES=6442450944
PROJECTVAULT_MAX_ARCHIVE_FILES=50000
PROJECTVAULT_MAX_ARCHIVE_EXPANDED_BYTES=34359738368
PROJECTVAULT_MAX_ARCHIVE_MEMBER_BYTES=1073741824
PROJECTVAULT_MAX_INDEXABLE_FILE_BYTES=20971520
PROJECTVAULT_MIN_FREE_BYTES=1073741824
