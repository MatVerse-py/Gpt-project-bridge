# MATVERSE OpenAI provider runtime
# Never commit a real API key. Inject it through the deployment/platform secret
# manager into OPENAI_API_KEY. The authenticated /providers/openai/* route does
# not read the value directly; EnvironmentSecretVault exposes it only through a
# bounded Secret Plane lease after the provider-exposure gate passes.
OPENAI_API_KEY=

# Version the injected credential explicitly when rotating it. This public
# version number is safe to persist; the credential value and locator are not.
OPENAI_SECRET_VERSION=1

# Explicit model binding is required. This prevents silent cost/capability drift.
OPENAI_MODEL=gpt-6-astra

# Optional runtime limits.
OPENAI_TIMEOUT_SECONDS=120
# OPENAI_MAX_OUTPUT_TOKENS=4096

# Existing MatVerse authenticated-principal registry remains required for
# /providers/openai/* endpoints.
# MATVERSE_PRINCIPALS_JSON={"operator":{"secret":"...","capabilities":["provider:openai:read","provider:openai:invoke"]}}

# Model-neutral agents. Bind the exact provider model explicitly; do not copy
# historical model names from an archive without checking current availability.
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
KILO_MODEL=
KILO_API_KEY=
KILO_ALLOW_ANONYMOUS=false

# Venice is OpenAI-compatible; the base URL is pinned in the adapter.
VENICE_MODEL=
VENICE_API_KEY=
MANUS_AGENT_PROFILE=lite
MANUS_API_KEY=
BASE44_APP_ID=
BASE44_ACCESS_TOKEN=
BASE44_ALLOW_WRITE=false

# External clients use their own authorized subscription/session. These fields
# label the enrolled identity; they do not authenticate Claude/Kilo themselves.
CLAUDE_CODE_MODEL=
CLAUDE_WEB_MODEL=
KILO_CODE_MODEL=
MATVERSE_AGENT_TIMEOUT_SECONDS=60
MATVERSE_AGENT_MAX_OUTPUT_TOKENS=1024

# Optional read-only corpus. Keep the database and original ZIPs outside git.
MATVERSE_MEMORY_DB=
MATVERSE_MEMORY_SOURCE_ID=integrated-export

# stdio MCP client signs requests with an existing provisioned Bridge principal.
# Credentials are injected locally; never put their real values in this file.
MATVERSE_BRIDGE_URL=http://127.0.0.1:8000
MATVERSE_AGENT_PRINCIPAL=
MATVERSE_AGENT_AUTH=

# xAI / Grok API adapter (Grok Web session is not reused).
XAI_MODEL=
XAI_API_KEY=

# Hugging Face Inference Providers (requires Inference Providers permission).
# This is a paid inference route; local Transformers is a separate runtime.
HF_MODEL=
HF_TOKEN=

# Local runtimes. Models must already be installed/served.
OLLAMA_MODEL=
OLLAMA_URL=http://host.docker.internal:11434
LLAMA_CPP_MODEL=
LLAMA_CPP_URL=http://host.docker.internal:8080
MATVERSE_ALLOW_HOST_DOCKER_INTERNAL=true
MATVERSE_STATE_BACKEND=sqlite
MATVERSE_BUILD_COMMIT=local

# ProjectVault local service. Keep this token server-side; Caddy injects it.
GPB_API_TOKEN=REPLACE_WITH_RANDOM_PROJECTVAULT_TOKEN
GPB_PUBLIC_API_URL=http://localhost:8787
PROJECTVAULT_AUTH_MODE=static
PROJECTVAULT_REQUIRED_SCOPE=projects.read

# Optional compatible read-only memory index. Do not point this at ProjectVault's
# database: ProjectVault and MNB memory use different schemas.
MATVERSE_MEMORY_DB=/var/lib/matverse/memory/memory.sqlite
MATVERSE_MEMORY_HOST_PATH=./data/memory

# Provision a unique principal secret (32 random bytes / 64 hex chars).
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
# Grant only the capabilities needed by the operator; never commit real values.
MATVERSE_PRINCIPALS_JSON='{"operator":{"secret":"REPLACE_WITH_64_HEX_RANDOM_BYTES","capabilities":["agent:read","agent:invoke","agent:invoke:gpt","agent:invoke:claude","agent:invoke:kilo","agent:invoke:venice","agent:invoke:grok","agent:invoke:huggingface","agent:invoke:ollama","agent:invoke:llama-cpp","agent:invoke:manus","agent:invoke:base44","agent:invoke:claude-code","agent:invoke:claude-web","agent:invoke:kilo-code","model-registry:read","model-registry:write","registry:write","session:create","session:read","handoff:send","inbox:read","handoff:ack","compare:execute","ledger:read","replay:read","memory:read","memory:content","federation:route","world:read","provider:openai:read","provider:openai:invoke"]}}'
