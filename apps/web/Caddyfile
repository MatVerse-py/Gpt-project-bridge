:3000 {
  encode zstd gzip
  root * /srv

  handle_path /bridge-api/* {
    # Preserve an explicitly supplied operator/OIDC bearer token. Only requests
    # without Authorization receive the server-side read-only token.
    @missing_auth not header Authorization *
    request_header @missing_auth Authorization "Bearer {$GPB_API_TOKEN}"
    reverse_proxy api:8787 {
      header_up -Origin
    }
  }

  # Strip only the UI prefix; the browser signs the canonical backend path.
  handle_path /core-api/* {
    reverse_proxy core-api:8000
  }

  # Static SPA fallback is deliberately inside the catch-all handle. If
  # try_files runs globally, it rewrites API paths to index.html before the
  # more-specific reverse-proxy handles can match them.
  handle {
    try_files {path} /index.html
    file_server
  }

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  }
}
