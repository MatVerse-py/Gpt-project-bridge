{
  "protocol": "matverse.secret-broker.v1",
  "secret_ref": "secret_ref://openai/matverse/executor-transplant",
  "capability": "openai.responses.create",
  "authentication": {
    "scheme": "github_oidc",
    "audience": "matverse-secret-broker",
    "static_cloud_credentials_in_github": "forbidden",
    "provider_secret_in_github_runner": "forbidden"
  },
  "broker_request": {
    "method": "POST",
    "path": "/v1/responses",
    "transport": "https_required",
    "headers": [
      "Authorization: Bearer <GitHub OIDC JWT>",
      "X-MatVerse-Secret-Ref",
      "X-MatVerse-Capability",
      "X-MatVerse-Request-Hash"
    ],
    "body": "OpenAI Responses-compatible request with store=false"
  },
  "broker_must": [
    "validate GitHub OIDC issuer, audience, expiry, and signature",
    "constrain repository/workflow/ref identity before granting the capability",
    "resolve secret_ref only inside the broker-side trust boundary",
    "never return the provider secret",
    "forward only the declared capability",
    "preserve store=false",
    "return a sanitized provider response",
    "emit a redacted audit receipt without bearer tokens or provider credentials"
  ],
  "claim_boundary": {
    "local_client_and_ci": "implemented_and_tested",
    "external_broker": "not_deployed_by_this_change",
    "vault_kms_hsm_backend": "HOLD_EXTERNAL_BACKEND_UNVERIFIED",
    "hardware_isolation": "HOLD_NOT_IMPLEMENTED"
  }
}
