{$GPB_DOMAIN} {
  encode zstd gzip

  @mcp path /mcp /.well-known/oauth-protected-resource
  handle @mcp {
    reverse_proxy api:8787
  }

  @core path /core-api/*
  handle_path @core {
    reverse_proxy core-api:8000
  }

  # The browser console is loopback-only until an authenticated OIDC/BFF
  # surface exists. Do not inject ProjectVault's server-side token into a
  # public browser session.
  handle {
    respond "Remote browser console is disabled pending OIDC/BFF authentication." 404
  }

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
  }
}
