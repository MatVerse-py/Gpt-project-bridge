{
  "alg": "RS256",
  "allowed_events": [
    "workflow_dispatch"
  ],
  "allowed_repository": "MatVerse-py/Gpt-project-bridge",
  "allowed_repository_owner": "MatVerse-py",
  "audience": "matverse-secret-broker",
  "capability": "openai.responses.create",
  "claim_boundary": {
    "HSM_KMS_Vault_backend": "HOLD until independently verified",
    "executor_transplant": "independent; no promotion from this service",
    "external_deployment": "HOLD until a reachable deployment is observed",
    "provider_secret_backend": "HOLD until external secret provisioning is observed",
    "service_implementation": "may PASS after CI"
  },
  "default_allowed_refs": [
    "refs/heads/main"
  ],
  "issuer": "https://token.actions.githubusercontent.com",
  "jwks_uri": "https://token.actions.githubusercontent.com/.well-known/jwks",
  "protocol": "matverse.external-secret-broker.v1",
  "provider": {
    "endpoint": "https://api.openai.com/v1/responses",
